{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@axile/engines": [
        "packages/engines/src/index.ts"
      ],
      "@axile/core": [
        "packages/core/src/index.ts"
      ],
      "@axile/providers": [
        "packages/providers/src/index.ts"
      ],
      "@axile/db": [
        "packages/db/src/index.ts"
      ],
      "@/*": [
        "apps/web/*"
      ],
      "@axile/economy": [
        "packages/economy/src/index.ts"
      ],
      "@axile/economy/mock-wallet": [
        "packages/economy/src/mock-wallet.ts"
      ],
      "@axile/economy/mock-ledger": [
        "packages/economy/src/mock-ledger.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "apps/web/.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web/.next",
    "packages/db/generated"
  ]
}
