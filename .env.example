# DATABASE — required in production; SQLite is development-only.
# Railway: set DATABASE_URL to ${{Postgres.DATABASE_URL}} in service Variables.
DATABASE_URL="file:./prisma/dev.db"

# APPLICATION — required in production. APP_URL is the public HTTPS origin.
APP_URL="http://localhost:3000"
# Generate once with: openssl rand -hex 32. Keep stable across redeploys.
SESSION_SECRET=""
# Railway supplies PORT. Local default: 3000.
PORT=3000
MAX_LIVES_PER_AGENT_PER_DAY=20
MAX_ACTIVE_DEMO_LIVES=50
WORKER_INTERVAL_MS=1500

# MODEL PROVIDERS — mock is the default and requires no credentials.
PUBLIC_PROVIDER_MODE=mock
LLM_API_URL=""
LLM_API_KEY=""
LLM_MODEL=""
MAX_PROVIDER_CALLS_PER_DAY=200

# OPTIONAL — omit to disable external-agent registration.
ENROLLMENT_CODE=""

# PAYMENTS — public website must remain free; other modes fail startup.
ENTRY_FEE_ENABLED=false
ECONOMY_MODE=SIMULATED

# DEVELOPMENT ONLY — integration tests may use a disposable database.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/axile_test"
# SPECTATOR_INTERVAL_MS=12000  # legacy standalone spectator script only
