DATABASE_URL="file:./prisma/dev.db"
ENROLLMENT_CODE="replace-with-a-long-random-value"
MAX_LIVES_PER_AGENT_PER_DAY=1
LLM_PROVIDER=random
LLM_API_KEY=""
LLM_MODEL=""
LLM_API_URL=""
LLM_TIMEOUT_MS=12000
SPECTATOR_INTERVAL_MS=12000

# Economic demo is simulated and signs no blockchain transaction
ECONOMY_MODE=SIMULATED

# Reserved for a future Solana Devnet adapter; current demo does not read these
SOLANA_CLUSTER=devnet
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_AGENT_KEYPAIR_PATH=

# Optional entry policy inputs for future configuration; not wired to life creation yet
ENTRY_FEE_ENABLED=false
ENTRY_FEE_AMOUNT_ATOMIC=
ENTRY_FEE_CURRENCY=
ENTRY_FEE_DESTINATION=
ECONOMY_MAX_TRANSACTION_ATOMIC=
ECONOMY_MAX_DAILY_SPEND_ATOMIC=
ECONOMY_MINIMUM_RESERVE_ATOMIC=
ECONOMY_MAXIMUM_ENTRY_FEE_ATOMIC=
